# uv-managed environment (recreate with `uv sync`)
.venv/
__pycache__/
*.pyc

# Test audio: ~107 MB of binaries. JamendoLyrics songs download from Hugging Face
# (datasets/jamendolyrics/jamendolyrics, subsets/en/mp3/); see OPENKARA_NOTES.md for
# the public-domain 78s. Ground truth is tracked.
test_songs/*.mp3
test_songs/*.ogg
test_songs/*.m4a
test_songs/*.flac
test_songs/*.opus
test_songs/*.wav

# Generated lyrics: regenerate with `uv run karaoke_lrc.py`. Not committed: several
# test songs are CC "no derivatives", and these are derived from them.
test_songs/*.lrc

# Known lyrics that karaoke_lrc.py fetched from LRCLIB (or that you wrote). They're
# the songs' lyrics, so they stay local.
*.lyrics.txt

# YouTube fetch lists you maintain locally (see fetch_youtube_audio.example.json).
fetch_youtube_audio.json
fetch_youtube_audio.*.json
!fetch_youtube_audio.example.json

fetch_jamendo_audio.json
fetch_jamendo_audio.*.json
!fetch_jamendo_audio.example.json

# MUSDB18 ground truth: lyrics of songs licensed for academic use only, so not
# published here. Regenerate with `uv run musdb_truth.py`.
test_songs/groundtruth/* - *

# OpenKara's library (database, imported media, stems) when it's pointed at test_songs/
test_songs/OpenKara/
