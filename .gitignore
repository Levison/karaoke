# uv-managed environment (recreate with `uv sync`)
.venv/
__pycache__/
*.pyc

# Test audio: ~107 MB of binaries. JamendoLyrics songs download from Hugging Face
# (datasets/jamendolyrics/jamendolyrics, subsets/en/mp3/); see OPENKARA_NOTES.md for
# the public-domain 78s. Ground truth is tracked.
test_songs/*.mp3
test_songs/*.ogg

# Generated lyrics: regenerate with `uv run karaoke_lrc.py`. Not committed: several
# test songs are CC "no derivatives", and these are derived from them.
test_songs/*.lrc

# OpenKara's library (database, imported media, stems) when it's pointed at test_songs/
test_songs/OpenKara/
